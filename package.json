{
  "name": "platform-demo-ai-agent",
  "version": "0.1.0",
  "description": "AI Platform Agent \u2014 turns a natural-language platform request into reviewed pull requests across the platform repositories",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "coverage": "c8 --reporter=json-summary --reporter=text tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src",
    "evals": "tsx src/evals/run-suite.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "evals:live": "tsx src/evals/run-suite.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.3",
    "@anthropic-ai/sdk": "^0.70.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "express": "^4.19.2",
    "octokit": "^4.0.2",
    "pino": "^9.3.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "c8": "^10.1.2",
    "eslint": "^9.5.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0"
  }
}
